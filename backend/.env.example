# Copy to .env via: python scripts/setup_env.py   (never commit .env)

# Signs dealer session tokens. Min 32 random characters.
SECRET_KEY=change-me
# Comma-separated PBKDF2 hashes (generate with scripts/hash_pin.py). Plain PINs are never stored.
DEALER_PIN_HASHES=change-me

TOKEN_TTL_MINUTES=60
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=300

DATABASE_PATH=data/test_drive.db
# Only needed when the frontend is hosted on a different origin, e.g. http://127.0.0.1:5500
CORS_ORIGINS=

DEALER_PHONE=+91 98765 43210
DEALER_EMAIL=rides@bgsw-mototorque.in
